{
  "name": "harness-lab",
  "version": "0.1.0",
  "private": true,
  "description": "AI 에이전트 하네스(Loop·Guardrails·Eval·Observability) 실험용 샌드박스",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bash agents/harness/evals/checks.sh",
    "trace": "node agents/harness/hooks/trace-report.mjs",
    "usage": "node agents/harness/usage/usage.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "metrics": "node agents/harness/metrics/metrics.mjs",
    "issue-link": "node agents/harness/evals/issue-link.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
